# Copy this file to `.env` and fill in the values.
# NEVER commit your real .env — it is gitignored on purpose.
# (Prisma reads .env, and Next.js reads it too, so a single .env works.)

# PostgreSQL connection string. For local development, point this at a
# local database. See DEVELOPER.md for a one-line Docker command that
# starts one that matches these credentials.
DATABASE_URL="postgresql://samaria:devpassword@localhost:5432/samaria_erp"

# NextAuth session-signing secret. Any long random string for local dev.
# Generate one with:  openssl rand -hex 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the app in development.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional ---
# Telegram notifications are OFF unless a bot token is set. The app runs
# fine without this.
# TELEGRAM_BOT_TOKEN=
