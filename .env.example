# ==============================================================================
# Samaria ERP — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your local values: cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://samaria:devpassword@localhost:5432/samaria_erp?schema=public"

# NextAuth Configuration
# Canonical URL of the site
NEXTAUTH_URL="http://localhost:3000"

# Secret key used to encrypt session cookies and JWT tokens (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET="your-generated-nextauth-secret-here"

# Environment
NODE_ENV="development"

# Telegram Bot Integration (Optional)
# Used for system notifications and alerts across ERP modules
TELEGRAM_BOT_TOKEN=""
