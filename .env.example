# Copy this file to `.env` and fill in the values.
# NEVER commit your real .env — it is gitignored on purpose.
# (Prisma reads .env, and Next.js reads it too, so a single .env works.)

# PostgreSQL connection string.
# For local dev: postgresql://samaria:devpassword@localhost:5432/samaria_erp
# For Dokploy:   postgresql://samaria:YOUR_PASSWORD@DB_HOST:5432/samaria_erp
DATABASE_URL="postgresql://samaria:devpassword@localhost:5432/samaria_erp"

# NextAuth session-signing secret. Any long random string for local dev.
# Generate one with:  openssl rand -hex 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the app.
# For local dev:  http://localhost:3000
# For production: https://app.samariaerp.org
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port the app listens on (Nixpacks/Dokploy sets this automatically)
PORT=3000

# Bind to all interfaces in production
# HOSTNAME=0.0.0.0

# --- Optional ---
# Telegram notifications are OFF unless a bot token is set. The app runs
# fine without this.
# TELEGRAM_BOT_TOKEN=

