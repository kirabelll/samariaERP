# Production Dockerfile for Next.js ERP application
# =================================================

FROM node:18-alpine

# Install system dependencies including build tools
RUN apk add --no-cache \
    libc6-compat \
    openssl \
    curl \
    python3 \
    make \
    g++ \
    git

WORKDIR /app

# Copy package.json and create a production version
COPY package.json ./

# Remove problematic optional dependencies and create production package.json
RUN node -e "
const pkg = require('./package.json');
delete pkg.devDependencies['@electric-sql/pglite'];
delete pkg.dependencies['@electric-sql/pglite-tools'];
delete pkg.dependencies['pg-gateway'];
pkg.dependencies['pg'] = '^8.22.0';
require('fs').writeFileSync('package.json', JSON.stringify(pkg, null, 2));
"

# Configure npm for better compatibility
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set legacy-peer-deps true && \
    npm config set fund false && \
    npm config set audit false && \
    npm config set progress false

# Install dependencies with multiple fallback strategies
RUN npm install --legacy-peer-deps --verbose || \
    npm install --force --legacy-peer-deps --verbose || \
    npm install --legacy-peer-deps --no-optional --verbose

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Build the application
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# Create required directories
RUN mkdir -p /app/uploads /app/logs /app/public/uploads

# Create comprehensive startup script
COPY << 'EOF' /app/start.sh
#!/bin/sh
set -e

echo "🚀 Starting Samaria ERP application..."

# Function to wait for database
wait_for_db() {
    echo "⏳ Waiting for database connection..."
    local attempt=0
    local max_attempts=60
    
    while [ $attempt -lt $max_attempts ]; do
        if npx prisma db push --accept-data-loss 2>/dev/null; then
            echo "✅ Database is ready!"
            return 0
        fi
        
        attempt=$((attempt + 1))
        echo "📡 Database not ready, attempt $attempt/$max_attempts, waiting 5 seconds..."
        sleep 5
    done
    
    echo "❌ Database connection timeout after $max_attempts attempts"
    return 1
}

# Function to run migrations
run_migrations() {
    echo "🔄 Running database migrations..."
    if npx prisma migrate deploy 2>/dev/null; then
        echo "✅ Migrations completed successfully"
    else
        echo "⚠️  Migrations may have already been applied"
    fi
}

# Function to seed database
seed_database() {
    echo "🌱 Seeding database with initial data..."
    if node prisma/seed.mjs 2>/dev/null; then
        echo "✅ Database seeded successfully"
    else
        echo "⚠️  Database may already be seeded"
    fi
}

# Function to start server
start_server() {
    echo "🌐 Starting Next.js server..."
    exec npm start
}

# Main execution
main() {
    wait_for_db || exit 1
    run_migrations
    seed_database
    start_server
}

# Handle signals for graceful shutdown
trap 'echo "🛑 Received shutdown signal"; exit 0' TERM INT

main
EOF

RUN chmod +x /app/start.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["/app/start.sh"]