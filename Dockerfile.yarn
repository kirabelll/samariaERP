# Yarn-based Dockerfile for Next.js ERP application
# ================================================

FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache libc6-compat openssl curl python3 make g++ git

# Install yarn globally
RUN npm install -g yarn

WORKDIR /app

# Copy package.json
COPY package.json ./

# Create yarn.lock if it doesn't exist and install dependencies
RUN yarn install --network-timeout 100000 --legacy-peer-deps || \
    yarn install --network-timeout 100000 --ignore-engines || \
    yarn install --network-timeout 100000

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Build the application
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN yarn build

# Create directories
RUN mkdir -p /app/uploads /app/logs /app/public/uploads

# Create startup script
RUN cat > /app/start.sh << 'EOF'
#!/bin/sh
set -e

echo "Starting ERP application..."

until npx prisma db push --accept-data-loss 2>/dev/null || npx prisma migrate deploy 2>/dev/null; do
  echo "Database not ready, waiting 5 seconds..."
  sleep 5
done

echo "Database is ready!"

npx prisma migrate deploy || echo "Migrations may have already been applied"
node prisma/seed.mjs || echo "Database may already be seeded"

echo "Starting Next.js server..."
exec yarn start
EOF

RUN chmod +x /app/start.sh

EXPOSE 3000

CMD ["/app/start.sh"]