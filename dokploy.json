{
  "name": "samaria-erp",
  "description": "Samaria Trading ERP System",
  "type": "nixpacks",
  "nixpacks": {
    "buildPath": ".",
    "configFile": "nixpacks.toml"
  },
  "domains": [
    {
      "host": "app.samariaerp.org",
      "port": 3000,
      "https": true,
      "certificateType": "letsencrypt"
    }
  ],
  "healthCheck": {
    "enabled": true,
    "path": "/api/health",
    "port": 3000,
    "interval": 30
  },
  "resources": {
    "memoryLimit": "512m",
    "cpuLimit": "0.5"
  }
}